FROM python:3.12.12-slim-bookworm

ENV PATH=/opt/gods-watching/.venv/bin:$PATH \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PROJECT_ENVIRONMENT=/opt/gods-watching/.venv \
    CUDA_DEVICE_ORDER=PCI_BUS_ID \
    TOKENIZERS_PARALLELISM=false

RUN apt-get update \
    && apt-get install --yes --no-install-recommends libgomp1 \
    && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:0.8.15 /uv /uvx /bin/

WORKDIR /opt/gods-watching/training
COPY training/pyproject.toml training/uv.lock ./
RUN uv sync --locked --no-dev --no-install-project

WORKDIR /opt/gods-watching
COPY server/src/gods_watching /opt/gods-watching/server/src/gods_watching
COPY assets/models.lock.json /opt/gods-watching/assets/models.lock.json
COPY qa/training/calibrate_memory.py /opt/gods-watching/qa/training/calibrate_memory.py

ENV PYTHONPATH=/opt/gods-watching/server/src

CMD ["python", "-m", "gods_watching.training.supervisor_cli"]
