#!/usr/bin/env sh
set -eu

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)

if ! command -v uv >/dev/null 2>&1; then
    echo "gods-watching: uv is required to select the locked project environment" >&2
    exit 127
fi

pending_signal=

capture_signal() {
    if [ -z "$pending_signal" ]; then
        pending_signal=$1
    fi
}

trap 'capture_signal TERM' TERM
trap 'capture_signal INT' INT

if PYTHON_BIN=$(uv run --project "$SCRIPT_DIR" python -c 'import sys; print(sys.executable)'); then
    :
elif [ "$pending_signal" = TERM ]; then
    exit 143
elif [ "$pending_signal" = INT ]; then
    exit 130
elif [ -z "$pending_signal" ]; then
    exit 1
fi

if [ -n "$pending_signal" ]; then
    export _GW_STARTUP_SIGNAL="$pending_signal"
fi
exec "$PYTHON_BIN" -m gods_watching.cli "$@"
