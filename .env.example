GW_BIND_HOST=0.0.0.0
GW_CAMERA_CIPHER_KEY=replace-with-a-stable-fernet-key
GW_MEDIA_CONTROL_PASSWORD=replace-with-a-random-control-password
GW_MEDIA_READER_PASSWORD=replace-with-a-random-reader-password
GW_OPERATOR_PASSWORD=admin
GW_OPERATOR_USERNAME=admin
GW_POSTGRES_PASSWORD=replace-with-a-database-password
GW_PUBLIC_HOST=127.0.0.1
GW_PUBLIC_ORIGIN=http://localhost:8080
GW_PUBLIC_PORT=8080
GW_PUBLIC_TLS_PORT=8443
GW_SECURE_COOKIE=false

# Absolute host path to the original CUHK-PEDES root (imgs/ and reid_raw.json).
# Leave blank to keep training unavailable while the rest of the product runs.
GW_TRAINING_DATASET_ROOT=

# Every service runs on the host network namespace, so these ports are bound on the
# host itself. Only the gateway (GW_PUBLIC_PORT / GW_PUBLIC_TLS_PORT) and the WebRTC
# UDP port listen on GW_BIND_HOST; the rest are bound to 127.0.0.1. Move any value
# that another program on this host already uses -- `./gods-watching doctor` rejects
# a duplicate before Compose tries to bind it.
GW_API_PORT=18000
GW_POSTGRES_PORT=15432
GW_TRITON_HTTP_PORT=18010
GW_TRITON_GRPC_PORT=18011
GW_TRITON_METRICS_PORT=18012
GW_MEDIA_RTSP_PORT=18554
GW_MEDIA_WHEP_PORT=18889
GW_MEDIA_CONTROL_PORT=19997
GW_MEDIA_WEBRTC_UDP_PORT=8189
GW_FIXTURE_RTSP_PORT=28554

# GW_PUBLIC_ORIGIN must be the exact scheme, host and port typed into the browser.
# The API rejects a login whose Origin header differs, so serving the console on a
# LAN address means setting both GW_PUBLIC_HOST and GW_PUBLIC_ORIGIN to it:
#   GW_PUBLIC_HOST=192.0.2.10
#   GW_PUBLIC_ORIGIN=http://192.0.2.10:8080
# Change GW_PUBLIC_PORT when 8080 is taken, and keep the port in GW_PUBLIC_ORIGIN
# identical or the browser's login request fails the same-origin check.

# LAN TLS: uncomment both lines and trust the exported Caddy root certificate.
# COMPOSE_FILE=compose.yaml:compose.tls.yaml
# GW_PUBLIC_ORIGIN=https://192.0.2.10:8443
